# Inkling 2 Mini on 2x R9700 with llama.cpp (HIP, gfx1201).
# Reviewed 2026-11-23.

# ROCm 10.2 base for the llama.cpp build and runtime, shared with the vLLM
# fullbuild (env/env.fullbuild).
ROCM_IMAGE=docker.io/rocm/dev-ubuntu-24.04:10.2.0-full@sha256:21801c0ba1bc4aba31f81ab11fe576c43daa7f2c7f42bac7baaa4d2f75273f86
GPU_ARCH=gfx1201
MAX_JOBS=16

# llama.cpp: upstream b12645 plus the pinned PR commits in inkling/llama-cpp-pins.txt.
# LLAMA_CPP_VERSION tags the local image; LLAMA_CPP_TREE is the git tree of the
# merged source, which the build verifies.
LLAMA_CPP_VERSION=b12645-inkling-e6d36c0
LLAMA_CPP_BASE_COMMIT=253671d8825729b607aeb7ad1ffc38547480c392
LLAMA_CPP_TREE=e6d36c0a0d16a449d5eb770b9cb48fec99a5177b
# Unsloth's pin-merge helper, at the fork commit whose pin set this follows.
UNSLOTH_LLAMA_CPP_COMMIT=ff43f5ef1e09c4bda5b4f530de56ef2593620abd
ADDITIVE_MERGE_SHA256=ef1742621b381eff5c9cc9324d3dd63ff4611c8e44616dab8e11a405191ab257

# Model files, from one pinned revision of unsloth/Inkling-2-Mini-GGUF. Each was
# verified to decode bit-exactly to thinkingmachines/Inkling-2-Mini @ b85c3cfa:
# NVFP4 experts unchanged, MXFP8 experts and all other weights as lossless BF16.
INKLING_GGUF_REPO=unsloth/Inkling-2-Mini-GGUF
INKLING_GGUF_REVISION=45fd08764f2b0bf16b03a5483a80e5c7aaec8772
INKLING_MODEL_FILE=Mainline_Support/Inkling-2-Mini-UD-Q8_K_XL.gguf_file
INKLING_MODEL_SHA256=2da51788d43a17e1f033bec420fa83ba9cb87ac1f0130dc9135a4d2ed2678b68
INKLING_MMPROJ_FILE=mmproj-BF16.gguf
INKLING_MMPROJ_SHA256=2c165c78790e78a3f45a2d1e9e931083e52ee69d45ff2a0dc9c281fdf1a666e7

# Latest Chat UI multi-platform image, resolved 2026-11-22.
CHATUI_IMAGE=ghcr.io/huggingface/chat-ui-db@sha256:3cb93a2a3f53aacf0927f4bfd3114a2eccfefb8e417a6b042f755b42253d2c30
