ARG ROCM_IMAGE
ARG GPU_ARCH=gfx1201
ARG MAX_JOBS=16

# -----------------------------------------------------------------------------
# Common ROCm + Python + PyTorch stack
# -----------------------------------------------------------------------------

FROM ${ROCM_IMAGE} AS framework-base

ARG GPU_ARCH
ARG TORCH_VERSION
ARG TORCHVISION_VERSION
ARG TORCHAUDIO_VERSION
ENV GPU_ARCH=${GPU_ARCH}
ENV ROCM_PATH=/opt/rocm
ENV PATH=/opt/venv/bin:/opt/rocm/bin:/opt/rocm/llvm/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:${LD_LIBRARY_PATH}

ENV PYTORCH_ROCM_ARCH=${GPU_ARCH}
ENV CMAKE_HIP_ARCHITECTURES=${GPU_ARCH}
ENV AMDGPU_TARGETS=${GPU_ARCH}
ENV GPU_TARGETS=${GPU_ARCH}

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        ccache \
        cmake \
        curl \
        git \
        libdrm-dev \
        libfmt-dev \
        libmsgpack-dev \
        libnuma-dev \
        libsqlite3-dev \
        mold \
        ninja-build \
        pkg-config \
        python3 \
        python3-dev \
        python3-venv \
        rustc \
        cargo \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
    && python -m pip install --upgrade \
        pip \
        uv \
        wheel \
        ninja \
        packaging \
        "setuptools>=77,<80" \
        setuptools-scm \
        setuptools-rust

# AMD's ROCm PyTorch stack, compiled specifically for the target GPU.
RUN --mount=type=cache,target=/root/.cache/pip \
    : "${TORCH_VERSION:?set TORCH_VERSION to the pinned torch version}" \
    && : "${TORCHVISION_VERSION:?set TORCHVISION_VERSION to the pinned torchvision version}" \
    && : "${TORCHAUDIO_VERSION:?set TORCHAUDIO_VERSION to the pinned torchaudio version}" \
    && python -m pip install \
        --index-url https://repo.amd.com/rocm/whl-multi-arch/ \
        "torch[device-${GPU_ARCH}]==${TORCH_VERSION}" \
        "torchvision[device-${GPU_ARCH}]==${TORCHVISION_VERSION}" \
        "torchaudio==${TORCHAUDIO_VERSION}"

RUN python - <<'PY'
import torch
print("torch:", torch.__version__)
print("ROCm:", torch.version.hip)
PY

# -----------------------------------------------------------------------------
# Flash Attention for RDNA
# -----------------------------------------------------------------------------

FROM framework-base AS flash-attention-builder

ARG FLASH_ATTN_REPO=https://github.com/ROCm/flash-attention.git
ARG FLASH_ATTN_REF
ARG MAX_JOBS

WORKDIR /src

RUN mkdir flash-attention \
    && git -C flash-attention init --quiet \
    && git -C flash-attention fetch --depth=1 --no-tags \
       "${FLASH_ATTN_REPO}" "${FLASH_ATTN_REF}" \
    && git -C flash-attention checkout --detach FETCH_HEAD \
    && git -C flash-attention submodule update --init --recursive --depth=1

RUN --mount=type=cache,target=/root/.cache/pip \
    cd /src/flash-attention \
    && FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
       MAX_JOBS="${MAX_JOBS}" \
       python -m pip wheel \
         --no-deps \
         --no-build-isolation \
         --wheel-dir=/wheels \
         .

# -----------------------------------------------------------------------------
# AITER for gfx1201
# -----------------------------------------------------------------------------

FROM framework-base AS aiter-builder

ARG AITER_REPO=https://github.com/ROCm/aiter.git
ARG AITER_REF
ARG GPU_ARCH
ARG MAX_JOBS

WORKDIR /src

RUN mkdir aiter \
    && git -C aiter init --quiet \
    && git -C aiter fetch --depth=1 --no-tags \
       "${AITER_REPO}" "${AITER_REF}" \
    && git -C aiter checkout --detach FETCH_HEAD \
    && git -C aiter submodule update --init --recursive --depth=1

COPY patches/aiter/ /patches/aiter/

RUN cd /src/aiter \
    && for patch in /patches/aiter/*.patch; do \
         [ -e "$patch" ] || continue; \
         git apply "$patch"; \
       done

RUN --mount=type=cache,target=/root/.cache/pip \
    cd /src/aiter \
    && python -m pip install -r requirements.txt \
    && AITER_USE_SYSTEM_TRITON=1 \
       GPU_ARCHS="${GPU_ARCH}" \
       MAX_JOBS="${MAX_JOBS}" \
       python setup.py bdist_wheel --dist-dir=/wheels

# -----------------------------------------------------------------------------
# vLLM
# -----------------------------------------------------------------------------

FROM framework-base AS vllm-builder

ARG ROCM_IMAGE
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG VLLM_REF
ARG VLLM_VERSION
ARG GPU_ARCH
ARG MAX_JOBS

WORKDIR /src

RUN mkdir vllm \
    && git -C vllm init --quiet \
    && git -C vllm fetch --depth=1 --no-tags "${VLLM_REPO}" "${VLLM_REF}" \
    && git -C vllm checkout --detach FETCH_HEAD

COPY --from=flash-attention-builder /wheels/ /dependency-wheels/
COPY --from=aiter-builder /wheels/ /dependency-wheels/

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install /dependency-wheels/*.whl

# Tell vLLM to retain the existing AMD PyTorch installation instead of trying
# to resolve or build another PyTorch stack.
RUN cd /src/vllm \
    && python use_existing_torch.py --prefix \
    && python -m pip install -r requirements/rocm.txt

RUN cd /src/vllm \
    && ./tools/install_protoc.sh \
    && bash build_rust.sh

RUN --mount=type=cache,target=/root/.cache/ccache \
    --mount=type=cache,target=/root/.cache/pip \
    cd /src/vllm \
    && : "${VLLM_VERSION:?set VLLM_VERSION to the release or development version}" \
    && VLLM_COMMIT="$(git rev-parse --short=12 HEAD)" \
    && ROCM_IMAGE_TAG="${ROCM_IMAGE##*:}" \
    && ROCM_VERSION="${ROCM_IMAGE_TAG%%-*}" \
    && ROCM_MAJOR="${ROCM_VERSION%%.*}" \
    && ROCM_MINOR_PATCH="${ROCM_VERSION#*.}" \
    && ROCM_MINOR="${ROCM_MINOR_PATCH%%.*}" \
    && case "${VLLM_VERSION}" in \
         *.dev*) SOURCE_VERSION="g${VLLM_COMMIT}." ;; \
         *) SOURCE_VERSION="" ;; \
       esac \
    && PACKAGE_VERSION="${VLLM_VERSION}+${SOURCE_VERSION}rocm${ROCM_MAJOR}${ROCM_MINOR}.${GPU_ARCH}" \
    && python -c 'from packaging.version import Version; import sys; print(f"Building vLLM {Version(sys.argv[1])}")' "${PACKAGE_VERSION}" \
    && VLLM_TARGET_DEVICE=rocm \
       PYTORCH_ROCM_ARCH="${GPU_ARCH}" \
       CMAKE_HIP_ARCHITECTURES="${GPU_ARCH}" \
       GPU_TARGETS="${GPU_ARCH}" \
       MAX_JOBS="${MAX_JOBS}" \
       VLLM_VERSION_OVERRIDE="${PACKAGE_VERSION}" \
       python setup.py bdist_wheel --dist-dir=/wheels

# -----------------------------------------------------------------------------
# Final runtime image
# -----------------------------------------------------------------------------

FROM framework-base AS runtime

COPY --from=flash-attention-builder /wheels/ /install/
COPY --from=aiter-builder /wheels/ /install/
COPY --from=vllm-builder /wheels/ /install/
COPY --from=vllm-builder /src/vllm/requirements/ /install/requirements/

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --no-deps /opt/rocm/share/amd_smi \
    && python -m pip install -r /install/requirements/rocm.txt \
    && python -m pip install /install/*.whl \
    && rm -rf /install

ENV FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE

ENV HSA_ENABLE_IPC_MODE_LEGACY=1
ENV HSA_NO_SCRATCH_RECLAIM=1
ENV HIP_FORCE_DEV_KERNARG=1
ENV LD_PRELOAD=/opt/rocm/lib/libamd_smi.so
ENV SAFETENSORS_FAST_GPU=1
ENV TORCH_BLAS_PREFER_HIPBLASLT=1
ENV PYTORCH_NVML_BASED_CUDA_CHECK=1
ENV TOKENIZERS_PARALLELISM=false

WORKDIR /workspace

EXPOSE 8180

ENTRYPOINT ["vllm", "serve"]