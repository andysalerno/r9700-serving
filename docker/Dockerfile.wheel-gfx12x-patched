# Patch an existing vLLM ROCm nightly wheel image with the gfx12x/R9700 runtime changes.
#
# Build from the llmhost repo root:
#   docker build -t localhost/vllm-rocm-wheel:<tag> \
#     --build-arg BASE_IMAGE=localhost/vllm-rocm-wheel:<base-tag> \
#     -f docker/Dockerfile.wheel-gfx12x-patched .

ARG BASE_IMAGE=localhost/vllm-rocm-wheel
ARG GFX_ARCH=gfx1201
FROM ${BASE_IMAGE}

ARG GFX_TARGET=gfx120X-all
ARG GFX_ARCH=gfx1201
ARG ROCM_WHEEL_INDEX_URL=https://rocm.nightlies.amd.com/whl-multi-arch/
# ARG ROCM_WHEEL_INDEX_URL=https://repo.amd.com/rocm/whl/gfx120X-all/
ARG ROCM_SDK_DEVEL_VERSION
ARG ROCM_SDK_LIBRARIES_DIR=_rocm_sdk_libraries
# ARG ROCM_SDK_LIBRARIES_DIR=_rocm_sdk_libraries_gfx120X_all
ARG USE_LATEST_AITER=0
# vLLM's ROCm 7.2/7.3 wheel index currently uses torch 2.10; AITER's ROCm 7.1
# v0.1.15 wheel is the torch-2.10 ABI build.
ARG AITER_LATEST_WHEEL_URL=https://github.com/ROCm/aiter/releases/download/v0.1.15/amd_aiter-0.1.15%2Brocm7.1.manylinux.2.28-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl
ARG AITER_LATEST_WHEEL_FILENAME=amd_aiter-0.1.15+rocm7.1-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl
ARG AITER_LATEST_FLYDSL_WHEEL_URL=https://rocm.frameworks-devreleases.amd.com/whl-staging/gfx942-gfx950/flydsl-0.1.9.dev20260529%2Bd7ae22d-cp312-cp312-manylinux_2_27_x86_64.whl
ARG AITER_LATEST_FLYDSL_WHEEL_FILENAME=flydsl-0.1.9.dev20260529+d7ae22d-cp312-cp312-manylinux_2_27_x86_64.whl

ENV ROCM_PATH=${SP}/_rocm_sdk_devel
ENV ROCM_HOME=${SP}/_rocm_sdk_devel
ENV HIP_PATH=${SP}/_rocm_sdk_devel
ENV HIP_HOME=${SP}/_rocm_sdk_devel
ENV HIP_DEVICE_LIB_PATH=${SP}/_rocm_sdk_devel/lib/llvm/amdgcn/bitcode
ENV DEVICE_LIB_PATH=${SP}/_rocm_sdk_devel/lib/llvm/amdgcn/bitcode
ENV CPATH=${SP}/_rocm_sdk_devel/include:${CPATH}
ENV LIBRARY_PATH=${SP}/_rocm_sdk_devel/lib:${LIBRARY_PATH}
ENV HIPBLASLT_TENSILE_LIBPATH=${SP}/${ROCM_SDK_LIBRARIES_DIR}/lib/hipblaslt/library
ENV ROCBLAS_TENSILE_LIBPATH=${SP}/${ROCM_SDK_LIBRARIES_DIR}/lib/rocblas/library
ENV LD_LIBRARY_PATH=${SP}/_rocm_sdk_devel/lib:${LD_LIBRARY_PATH}

RUN set -eux; \
    PYTHON_BIN="$(command -v python || command -v python3)"; \
    uv pip install --no-deps \
        --index-url "${ROCM_WHEEL_INDEX_URL}" \
        "rocm-sdk-devel==${ROCM_SDK_DEVEL_VERSION}"; \
    "${PYTHON_BIN}" - <<'PY'
import importlib.util
import os
import site
import tarfile

if importlib.util.find_spec("_rocm_sdk_devel") is not None:
    raise SystemExit(0)

site_packages = next(
    (p for p in site.getsitepackages() if p.endswith("site-packages")),
    site.getsitepackages()[0],
)
tar_path = os.path.join(site_packages, "rocm_sdk_devel", "_devel.tar")
with tarfile.open(tar_path) as archive:
    root = os.path.abspath(site_packages)
    for member in archive.getmembers():
        target = os.path.abspath(os.path.join(root, member.name))
        if not target.startswith(root + os.sep):
            raise RuntimeError(f"Unsafe ROCm SDK member path: {member.name}")
    archive.extractall(root)
os.remove(tar_path)
PY

RUN set -eux; \
    case "${USE_LATEST_AITER}" in \
        0|false|FALSE|no|NO|"") \
            echo "Keeping AITER from the base vLLM wheel image"; \
            ;; \
        1|true|TRUE|yes|YES) \
            PYTHON_BIN="$(command -v python || command -v python3)"; \
            FLYDSL_WHEEL="/tmp/${AITER_LATEST_FLYDSL_WHEEL_FILENAME}"; \
            AITER_WHEEL="/tmp/${AITER_LATEST_WHEEL_FILENAME}"; \
            curl -fL "${AITER_LATEST_FLYDSL_WHEEL_URL}" -o "${FLYDSL_WHEEL}"; \
            uv pip install --force-reinstall --no-deps "${FLYDSL_WHEEL}"; \
            curl -fL "${AITER_LATEST_WHEEL_URL}" -o "${AITER_WHEEL}"; \
            UV_SKIP_WHEEL_FILENAME_CHECK=1 uv pip install --force-reinstall --no-deps "${AITER_WHEEL}"; \
            rm -f "${FLYDSL_WHEEL}" "${AITER_WHEEL}"; \
            "${PYTHON_BIN}" -c 'import importlib.metadata as md, importlib.util, torch, triton; assert importlib.util.find_spec("aiter") is not None; print("amd-aiter", md.version("amd-aiter")); print("flydsl", md.version("flydsl")); print("torch", torch.__version__); print("triton", triton.__version__)'; \
            ;; \
        *) \
            echo "USE_LATEST_AITER must be 0/false/no or 1/true/yes" >&2; \
            exit 1; \
            ;; \
    esac

COPY docker/patches/GFX12x_R9700_AITER_ENABLEMENT.patch /tmp/GFX12x_R9700_AITER_ENABLEMENT.patch
COPY docker/patches/GFX12x_R9700_rocm713_RUNTIME.patch /tmp/GFX12x_R9700_rocm713_RUNTIME.patch

RUN set -eux; \
    PYTHON_BIN="$(command -v python || command -v python3)"; \
    SITE_PACKAGES="$("${PYTHON_BIN}" -c 'import site; paths = site.getsitepackages(); print(next((p for p in paths if p.endswith("site-packages")), paths[0]))')"; \
    cd "${SITE_PACKAGES}"; \
    for patch in \
        /tmp/GFX12x_R9700_AITER_ENABLEMENT.patch \
        /tmp/GFX12x_R9700_rocm713_RUNTIME.patch; do \
        if git apply --check "${patch}"; then \
            git apply "${patch}"; \
            echo "Applied ${patch##*/}"; \
        elif git apply --reverse --check "${patch}"; then \
            echo "${patch##*/} is already applied"; \
        else \
            git apply --check "${patch}"; \
        fi; \
    done; \
    "${PYTHON_BIN}" -m py_compile \
        vllm/_aiter_ops.py \
        vllm/compilation/passes/fusion/rms_quant_fusion.py \
        vllm/model_executor/layers/fused_moe/experts/fused_batched_moe.py \
        vllm/platforms/__init__.py \
        vllm/platforms/rocm.py \
        vllm/utils/import_utils.py \
        vllm/v1/core/single_type_kv_cache_manager.py \
        vllm/v1/sample/ops/topk_topp_sampler.py \
        vllm/v1/worker/gpu_worker.py \
        vllm/v1/attention/backends/rocm_aiter_fa.py \
        vllm/v1/attention/backends/rocm_aiter_unified_attn.py
