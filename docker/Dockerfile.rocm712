# syntax=docker/dockerfile:1

# Docker's Ubuntu tag is 24.04/noble rather than a point-release-specific 24.04.3 tag.
# AMD's ROCm 7.12 selector targets Ubuntu 24.04.3; this is the closest standard base.
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# Default: ROCm 7.12 core runtime for gfx120x / AI PRO R9700.
# For build images that need ROCm headers, static libs, CMake configs, and compilers,
# build with:
#   --build-arg ROCM_META_PACKAGE=amdrocm-core-dev7.12-gfx120x
# ARG ROCM_META_PACKAGE=amdrocm7.12-gfx120x
ARG ROCM_META_PACKAGE=amdrocm-core-sdk-gfx120x

# Minimal packages needed to register AMD's apt repo and install ROCm.
# AMD's Docker-container prerequisite section calls out missing essentials such
# as sudo/wget/python3/cmake/libgfortran5; gnupg/ca-certificates are needed
# for the signed apt repo setup.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        gnupg \
        wget \
        sudo \
        python3 \
        cmake \
        libgfortran5 \
    ; \
    rm -rf /var/lib/apt/lists/*

# Register ROCm 7.12 apt repository for Ubuntu 24.04.
RUN set -eux; \
    mkdir --parents --mode=0755 /etc/apt/keyrings; \
    wget -qO - https://repo.amd.com/rocm/packages/gpg/rocm.gpg \
        | gpg --dearmor \
        > /etc/apt/keyrings/amdrocm.gpg; \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/amdrocm.gpg] https://repo.amd.com/rocm/packages/ubuntu2404 stable main" \
        > /etc/apt/sources.list.d/rocm.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends "${ROCM_META_PACKAGE}"; \
    rm -rf /var/lib/apt/lists/*

# ROCm 7.12 package layout uses /opt/rocm/core/lib plus rocm_sysdeps.
# AMD's post-install docs add these paths to LD_LIBRARY_PATH.
ENV ROCM_PATH=/opt/rocm
ENV LD_LIBRARY_PATH=/opt/rocm/core/lib/rocm_sysdeps/lib:/opt/rocm/core/lib:${LD_LIBRARY_PATH}
ENV PATH=/opt/rocm/bin:/opt/rocm/core/bin:${PATH}

# Useful default validation command.
CMD ["bash", "-lc", "rocminfo || true; amd-smi version || true; bash"]