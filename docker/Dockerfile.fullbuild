ARG ROCM_IMAGE=docker.io/rocm/dev-ubuntu-24.04:7.14.0-full
ARG GPU_ARCH=gfx1201
ARG MAX_JOBS=16
ARG AITER_MODE

# Select AITER without changing the rest of the source build:
#   podman build --build-arg AITER_MODE=prebuilt -f docker/Dockerfile.fullbuild .
#   podman build --build-arg AITER_MODE=build -f docker/Dockerfile.fullbuild .

# -----------------------------------------------------------------------------
# Common ROCm + Python + PyTorch stack
# -----------------------------------------------------------------------------

FROM ${ROCM_IMAGE} AS framework-base

ARG GPU_ARCH
ENV GPU_ARCH=${GPU_ARCH}
ENV ROCM_PATH=/opt/rocm
ENV PATH=/opt/venv/bin:/opt/rocm/bin:/opt/rocm/llvm/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:${LD_LIBRARY_PATH}

ENV PYTORCH_ROCM_ARCH=${GPU_ARCH}
ENV CMAKE_HIP_ARCHITECTURES=${GPU_ARCH}
ENV AMDGPU_TARGETS=${GPU_ARCH}
ENV GPU_TARGETS=${GPU_ARCH}

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        ccache \
        cmake \
        curl \
        git \
        libfmt-dev \
        libmsgpack-dev \
        libnuma-dev \
        libsqlite3-dev \
        mold \
        ninja-build \
        pkg-config \
        python3 \
        python3-dev \
        python3-venv \
        rustc \
        cargo \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
    && python -m pip install --upgrade \
        pip \
        uv \
        wheel \
        ninja \
        packaging \
        "setuptools>=77,<80" \
        setuptools-scm \
        setuptools-rust

# AMD's ROCm 7.14 PyTorch stack, compiled specifically for gfx1201.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
        --index-url https://repo.amd.com/rocm/whl-multi-arch/ \
        "torch[device-gfx1201]==2.11.0+rocm7.14.0" \
        "torchvision[device-gfx1201]==0.26.0+rocm7.14.0" \
        "torchaudio==2.11.0+rocm7.14.0"

RUN python - <<'PY'
import torch
print("torch:", torch.__version__)
print("ROCm:", torch.version.hip)
PY

# -----------------------------------------------------------------------------
# Flash Attention for RDNA
# -----------------------------------------------------------------------------

FROM framework-base AS flash-attention-builder

ARG FLASH_ATTN_REPO=https://github.com/ROCm/flash-attention.git
ARG FLASH_ATTN_REF=b3ae4966b2567811880db10d9e040a775b99c7d7
ARG MAX_JOBS

WORKDIR /src

RUN git clone --recursive "${FLASH_ATTN_REPO}" flash-attention \
    && cd flash-attention \
    && git checkout "${FLASH_ATTN_REF}"

# COPY patches/flash-attention/ /patches/flash-attention/

# RUN cd /src/flash-attention \
#     && for patch in /patches/flash-attention/*.patch; do \
#          [ -e "$patch" ] || continue; \
#          git apply "$patch"; \
#        done

RUN --mount=type=cache,target=/root/.cache/pip \
    cd /src/flash-attention \
    && FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
       MAX_JOBS="${MAX_JOBS}" \
       python -m pip wheel \
         --no-build-isolation \
         --wheel-dir=/wheels \
         .

# -----------------------------------------------------------------------------
# AITER for gfx1201
# -----------------------------------------------------------------------------

FROM framework-base AS aiter-builder

ARG AITER_MODE
ARG AITER_REPO=https://github.com/ROCm/aiter.git
ARG AITER_REF=620287969c9ce18cd2033ebbdfd13107800f7f3f
ARG GPU_ARCH
ARG MAX_JOBS

WORKDIR /src

COPY .env/env.aiter.latest /tmp/aiter-prebuilt.env

# The upstream wheels target gfx942/gfx950; vanilla vLLM leaves AITER disabled
# on gfx1201.
RUN --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    case "${AITER_MODE:?set AITER_MODE to build or prebuilt}" in \
        build) \
            git clone --recursive "${AITER_REPO}" aiter; \
            cd aiter; \
            git checkout "${AITER_REF}"; \
            git submodule update --init --recursive; \
            python -m pip install -r requirements.txt; \
            AITER_USE_SYSTEM_TRITON=1 \
            PREBUILD_KERNELS=1 \
            GPU_ARCHS="${GPU_ARCH}" \
            MAX_JOBS="${MAX_JOBS}" \
            python setup.py bdist_wheel --dist-dir=/wheels; \
            ;; \
        prebuilt) \
            set -a; \
            . /tmp/aiter-prebuilt.env; \
            set +a; \
            : "${AITER_LATEST_WHEEL_URL:?AITER_LATEST_WHEEL_URL must be set}"; \
            : "${AITER_LATEST_FLYDSL_WHEEL_URL:?AITER_LATEST_FLYDSL_WHEEL_URL must be set}"; \
            mkdir -p /wheels; \
            AITER_WHEEL_NAME="$(basename "${AITER_LATEST_WHEEL_URL}" | sed 's/%2[Bb]/+/g')"; \
            FLYDSL_WHEEL_NAME="$(basename "${AITER_LATEST_FLYDSL_WHEEL_URL}" | sed 's/%2[Bb]/+/g')"; \
            curl -fsSL "${AITER_LATEST_WHEEL_URL}" -o "/wheels/${AITER_WHEEL_NAME}"; \
            curl -fsSL "${AITER_LATEST_FLYDSL_WHEEL_URL}" -o "/wheels/${FLYDSL_WHEEL_NAME}"; \
            ;; \
        *) \
            echo "AITER_MODE must be build or prebuilt, got: ${AITER_MODE}" >&2; \
            exit 1; \
            ;; \
    esac; \
    rm -f /tmp/aiter-prebuilt.env

# -----------------------------------------------------------------------------
# vLLM
# -----------------------------------------------------------------------------

FROM framework-base AS vllm-builder

ARG AITER_MODE
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG VLLM_REF=752a3a504485790a2e8491cacbb35c137339ad34
ARG GPU_ARCH
ARG MAX_JOBS

WORKDIR /src

RUN git clone "${VLLM_REPO}" vllm \
    && cd vllm \
    && git checkout "${VLLM_REF}"

# COPY patches/vllm/ /patches/vllm/

# RUN cd /src/vllm \
#     && for patch in /patches/vllm/*.patch; do \
#          [ -e "$patch" ] || continue; \
#          git apply "$patch"; \
#        done

COPY --from=flash-attention-builder /wheels/ /dependency-wheels/
COPY --from=aiter-builder /wheels/ /dependency-wheels/

# Preserve the explicitly paired development FlyDSL wheel despite AITER's
# stricter published dependency metadata.
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "${AITER_MODE}" = prebuilt ]; then \
        python -m pip install /dependency-wheels/flash_attn-*.whl; \
        python -m pip install --no-deps \
            /dependency-wheels/amd_aiter-*.whl \
            /dependency-wheels/flydsl-*.whl; \
    else \
        python -m pip install /dependency-wheels/*.whl; \
    fi

# Tell vLLM to retain the existing AMD PyTorch installation instead of trying
# to resolve or build another PyTorch stack.
RUN cd /src/vllm \
    && python use_existing_torch.py --prefix \
    && python -m pip install -r requirements/rocm.txt

RUN cd /src/vllm \
    && ./tools/install_protoc.sh \
    && bash build_rust.sh

RUN --mount=type=cache,target=/root/.cache/ccache \
    --mount=type=cache,target=/root/.cache/pip \
    cd /src/vllm \
    && VLLM_TARGET_DEVICE=rocm \
       PYTORCH_ROCM_ARCH="${GPU_ARCH}" \
       CMAKE_HIP_ARCHITECTURES="${GPU_ARCH}" \
       GPU_TARGETS="${GPU_ARCH}" \
       MAX_JOBS="${MAX_JOBS}" \
       SETUPTOOLS_SCM_PRETEND_VERSION="0.25.1+rocm714.gfx1201" \
       python setup.py bdist_wheel --dist-dir=/wheels

# -----------------------------------------------------------------------------
# Final runtime image
# -----------------------------------------------------------------------------

FROM framework-base AS runtime

ARG AITER_MODE

COPY --from=flash-attention-builder /wheels/ /install/
COPY --from=aiter-builder /wheels/ /install/
COPY --from=vllm-builder /wheels/ /install/
COPY --from=vllm-builder /src/vllm/requirements/ /install/requirements/

# Install the prebuilt AITER/FlyDSL pair without dependency re-resolution.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install -r /install/requirements/rocm.txt \
    && if [ "${AITER_MODE}" = prebuilt ]; then \
           python -m pip install \
               /install/flash_attn-*.whl \
               /install/vllm-*.whl; \
           python -m pip install --no-deps \
               /install/amd_aiter-*.whl \
               /install/flydsl-*.whl; \
       else \
           python -m pip install /install/*.whl; \
       fi \
    && rm -rf /install

ENV FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE

ENV HSA_ENABLE_IPC_MODE_LEGACY=1
ENV HSA_NO_SCRATCH_RECLAIM=1
ENV HIP_FORCE_DEV_KERNARG=1
ENV SAFETENSORS_FAST_GPU=1
ENV TORCH_BLAS_PREFER_HIPBLASLT=1
ENV PYTORCH_NVML_BASED_CUDA_CHECK=1
ENV TOKENIZERS_PARALLELISM=false

WORKDIR /workspace

EXPOSE 8000

ENTRYPOINT ["vllm", "serve"]