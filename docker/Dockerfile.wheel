### A Dockerfile for a usable vllm environment with AMD ROCm nightlies for gfx1201 and vllm ROCm wheels.
FROM ubuntu:24.04

ARG GFX_TARGET=gfx120X-all
ARG GFX_ARCH=gfx1201
ARG PYTHON=python3.12
ARG VLLM_WHEEL_URL=https://wheels.vllm.ai/rocm
ARG VLLM_VERSION=0.21.0+rocm722
ARG FLASH_ATTN_VERSION=2.8.3
ARG ROCM_WHEEL_INDEX_URL=https://rocm.nightlies.amd.com/whl-multi-arch/
# ARG ROCM_WHEEL_INDEX_URL=https://repo.amd.com/rocm/whl/gfx120X-all/
ARG ROCM_SDK_CORE_VERSION=7.14.0a20260606
# ARG ROCM_SDK_CORE_VERSION=7.13.0
ARG ROCM_SDK_LIBRARIES_VERSION=7.14.0a20260606
# ARG ROCM_SDK_LIBRARIES_VERSION=7.13.0
ARG ROCM_SDK_LIBRARIES_PACKAGE=rocm-sdk-libraries
# ARG ROCM_SDK_LIBRARIES_PACKAGE=rocm-sdk-libraries-gfx120X-all
ARG ROCM_SDK_DEVICE_PACKAGE=rocm-sdk-device-gfx1201
# ARG ROCM_SDK_DEVICE_PACKAGE=
ARG ROCM_SDK_LIBRARIES_DIR=_rocm_sdk_libraries
# ARG ROCM_SDK_LIBRARIES_DIR=_rocm_sdk_libraries_gfx120X_all

ENV DEBIAN_FRONTEND=noninteractive
ENV VIRTUAL_ENV=/opt/vllm
ENV PATH=/opt/vllm/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-dev python3.12-venv \
    libatomic1 libdrm2 libdrm-amdgpu1 libelf1 libgfortran5 libgomp1 \
    libjpeg-turbo8 libnuma1 libopenmpi3t64 \
    git curl ca-certificates gcc g++ \
    && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m venv /opt/vllm \
    && python -m pip install --upgrade pip setuptools wheel uv

# Install vLLM's ROCm wheel and the exact ROCm stack it was built against.
RUN uv pip install \
    --find-links ${VLLM_WHEEL_URL}/vllm/ \
    --find-links ${VLLM_WHEEL_URL}/torch/ \
    --find-links ${VLLM_WHEEL_URL}/torchvision/ \
    --find-links ${VLLM_WHEEL_URL}/torchaudio/ \
    --find-links ${VLLM_WHEEL_URL}/triton/ \
    --find-links ${VLLM_WHEEL_URL}/triton-kernels/ \
    --find-links ${VLLM_WHEEL_URL}/amdsmi/ \
    --find-links ${VLLM_WHEEL_URL}/amd-aiter/ \
    --find-links ${VLLM_WHEEL_URL}/flash-attn/ \
    vllm==${VLLM_VERSION} flash-attn==${FLASH_ATTN_VERSION} \
    && uv pip install --no-deps torch-c-dlpack-ext

# The vLLM ROCm torch wheel expects ROCm userspace libraries at runtime; install
# AMD's pip-packaged SDK libraries without letting them replace torch/vLLM.
RUN uv pip install --no-deps \
    --index-url ${ROCM_WHEEL_INDEX_URL} \
    rocm-sdk-core==${ROCM_SDK_CORE_VERSION} \
    ${ROCM_SDK_LIBRARIES_PACKAGE}==${ROCM_SDK_LIBRARIES_VERSION} \
    ${ROCM_SDK_DEVICE_PACKAGE:+${ROCM_SDK_DEVICE_PACKAGE}==${ROCM_SDK_LIBRARIES_VERSION}} \
    rocm-sdk-devel==${ROCM_SDK_CORE_VERSION} \
    && python - <<'PY'
import os
import site
import tarfile

site_packages = next(
    (p for p in site.getsitepackages() if p.endswith("site-packages")),
    site.getsitepackages()[0],
)
tar_path = os.path.join(site_packages, "rocm_sdk_devel", "_devel.tar")
with tarfile.open(tar_path) as archive:
    root = os.path.abspath(site_packages)
    for member in archive.getmembers():
        target = os.path.abspath(os.path.join(root, member.name))
        if not target.startswith(root + os.sep):
            raise RuntimeError(f"Unsafe ROCm SDK member path: {member.name}")
    archive.extractall(root)
os.remove(tar_path)
PY

# Let bundled ROCm libraries be found at runtime.
ENV SP=/opt/vllm/lib/python3.12/site-packages
ENV ROCM_PATH=${SP}/_rocm_sdk_devel
ENV ROCM_HOME=${SP}/_rocm_sdk_devel
ENV HIP_PATH=${SP}/_rocm_sdk_devel
ENV HIP_HOME=${SP}/_rocm_sdk_devel
ENV HIP_DEVICE_LIB_PATH=${SP}/_rocm_sdk_devel/lib/llvm/amdgcn/bitcode
ENV DEVICE_LIB_PATH=${SP}/_rocm_sdk_devel/lib/llvm/amdgcn/bitcode
ENV CPATH=${SP}/_rocm_sdk_devel/include:${CPATH}
ENV LIBRARY_PATH=${SP}/_rocm_sdk_devel/lib:${LIBRARY_PATH}
ENV PYTHONPATH=${SP}/_rocm_sdk_core/share/amd_smi
ENV HIPBLASLT_TENSILE_LIBPATH=${SP}/${ROCM_SDK_LIBRARIES_DIR}/lib/hipblaslt/library
ENV ROCBLAS_TENSILE_LIBPATH=${SP}/${ROCM_SDK_LIBRARIES_DIR}/lib/rocblas/library
ENV LD_LIBRARY_PATH=${SP}/torch/lib:${SP}/_rocm_sdk_devel/lib:${SP}/_rocm_sdk_core/lib:${SP}/_rocm_sdk_core/lib/llvm/lib:${SP}/_rocm_sdk_core/lib/rocm_sysdeps/lib:${SP}/_rocm_sdk_core/lib/host-math/lib:${SP}/_rocm_sdk_libraries/lib:${SP}/_rocm_sdk_libraries_gfx120X_all/lib:${LD_LIBRARY_PATH}

ENV HIP_PLATFORM=amd \
    VLLM_TARGET_DEVICE=rocm \
    VLLM_ROCM_GCN_ARCH=${GFX_ARCH} \
    PYTORCH_ROCM_ARCH=${GFX_ARCH} \
    HIP_ARCHITECTURES=${GFX_ARCH} \
    AMDGPU_TARGETS=${GFX_ARCH} \
    GPU_ARCHS=${GFX_ARCH} \
    SAFETENSORS_FAST_GPU=1 \
    TOKENIZERS_PARALLELISM=false

RUN python -c 'import importlib.metadata as md, torch, vllm, vllm._C, vllm._rocm_C, flash_attn; print(f"PyTorch {torch.__version__}"); print(f"ROCm built-in: {torch.version.hip is not None}"); print(f"vLLM {vllm.__version__}"); print("flash-attn", md.version("flash-attn")); print("vLLM ROCm native extensions OK")'

ENTRYPOINT ["vllm", "serve"]